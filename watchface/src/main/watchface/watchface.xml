        <!-- Titles open the app too, so tapping anywhere along the middle works. -->
        <PartText x="45" y="98" width="360" height="50">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="{{TITLE_SIZE}}" weight="BOLD" color="#FFC62828"><![CDATA[{{TITLE_TOP}}]]></Font>
            </Text>
            <Launch target="{{LAUNCH}}" />
        </PartText>
        <PartText x="45" y="268" width="360" height="46">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="{{TITLE_SIZE}}" weight="BOLD" color="#FF3B2A1A"><![CDATA[{{TITLE_BOTTOM}}]]></Font>
            </Text>
            <Launch target="{{LAUNCH}}" />
        </PartText>

        <!-- Flag of the place where it is beer o'clock right now, in colour. -->
        <ComplicationSlot slotId="0" x="196" y="152" width="58" height="58" supportedTypes="SMALL_IMAGE" isCustomizable="TRUE">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE"
                primaryProvider="{{PROVIDER}}" primaryProviderType="SMALL_IMAGE" />
            <BoundingOval x="0" y="0" width="58" height="58" />
            <Complication type="SMALL_IMAGE">
                <PartImage x="0" y="0" width="58" height="58">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
        </ComplicationSlot>

        <!-- City and countdown to the next round. -->
        <ComplicationSlot slotId="1" x="115" y="316" width="220" height="50" supportedTypes="LONG_TEXT SHORT_TEXT" isCustomizable="TRUE">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="LONG_TEXT"
                primaryProvider="{{PROVIDER}}" primaryProviderType="LONG_TEXT" />
            <BoundingBox x="0" y="0" width="220" height="50" />
            <Complication type="LONG_TEXT">
                <PartText x="0" y="0" width="220" height="29">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="23" weight="BOLD" color="#FF3B2A1A">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="0" width="220" height="29" alpha="0">
                    <Variant mode="AMBIENT" target="alpha" value="255" />
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="23" weight="BOLD" color="#FFBDBDBD">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="29" width="220" height="21">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="16" color="#FF3B2A1A">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="29" width="220" height="21" alpha="0">
                    <Variant mode="AMBIENT" target="alpha" value="255" />
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="16" color="#FFBDBDBD">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="220" height="50">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="24" weight="BOLD" color="#FF3B2A1A">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
