        <!-- Hands: dark by day, light in ambient mode. -->
        <AnalogClock x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <HourHand resource="hour_hand" x="218" y="115" width="14" height="130" pivotX="0.5" pivotY="0.846" />
            <MinuteHand resource="minute_hand" x="220" y="60" width="10" height="190" pivotX="0.5" pivotY="0.868" />
            <SecondHand resource="second_hand" x="223" y="45" width="4" height="215" pivotX="0.5" pivotY="0.837">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Sweep frequency="15" />
            </SecondHand>
        </AnalogClock>
        <AnalogClock x="0" y="0" width="450" height="450" alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="255" />
            <HourHand resource="hour_hand_ambient" x="218" y="115" width="14" height="130" pivotX="0.5" pivotY="0.846" />
            <MinuteHand resource="minute_hand_ambient" x="220" y="60" width="10" height="190" pivotX="0.5" pivotY="0.868" />
