            <Ellipse x="0" y="0" width="450" height="450"><Fill color="#FFFDF6E3" /></Ellipse>
            <Rectangle x="0" y="250" width="450" height="200">
                <Fill color="#FFF6B400">
                    <LinearGradient startX="0" startY="250" endX="0" endY="450" colors="#FFF6B400 #FFD98300" positions="0 1" />
                </Fill>
            </Rectangle>
        </PartDraw>
        <!-- Soft wavy foam on the beer (tools/make_foam.py), then the rim on top. -->
        <PartImage x="0" y="228" width="450" height="44">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Image resource="foam" />
        </PartImage>
        <PartDraw x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Ellipse x="4" y="4" width="442" height="442"><Stroke color="#FF3B2A1A" thickness="8" /></Ellipse>
        </PartDraw>

        <!-- Dial: twelve times the same digit. Dark by day, light in ambient mode. -->
