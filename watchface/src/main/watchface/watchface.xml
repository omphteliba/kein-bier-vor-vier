            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="42" weight="BOLD" color="#FF3B2A1A"><![CDATA[{{DIGIT}}]]></Font>
