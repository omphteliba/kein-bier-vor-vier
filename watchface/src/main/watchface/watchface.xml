<?xml version="1.0" encoding="utf-8"?>
<!--
  Watch Face Format template. Gradle fills in the double-brace placeholders per
  edition (see watchface/build.gradle.kts), so both variants share one layout.
  Flag, city and countdown come from the app's complication data source.
-->
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="ANALOG" />
    <Metadata key="PREVIEW_TIME" value="10:08:32" />

    <Scene backgroundColor="#FF000000">
        <!-- Glass: cream dial, beer from the middle down. -->
        <PartDraw x="0" y="0" width="450" height="450">
